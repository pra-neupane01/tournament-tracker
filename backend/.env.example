# Database Configuration
ESPORTS_DB_URL=jdbc:postgresql://localhost:5432/esports_management_app
ESPORTS_DB_USERNAME=postgres
ESPORTS_DB_PASSWORD=postgres

# Server Configuration
SERVER_PORT=8080

# File Upload Limits
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT Configuration (For Chunk 2)
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_bytes_long
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
